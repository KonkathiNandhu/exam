# First local test: same computer, two tabs. No phone QR is generated.
PAIRING_MODE=lan
LOCAL_PAIRING_PREVIEW=true
PORT=3000
BIND_HOST=127.0.0.1

# Remote pairing: disable local preview and choose LAN or cloud below.
PUBLIC_APP_URL=
PUBLIC_API_URL=
PUBLIC_WS_URL=
# Exact additional browser origins (no wildcard). App origin is included automatically.
ALLOWED_APP_ORIGINS=http://localhost:3000

# LAN only: explicitly enable reachable binding; select one assigned private IPv4.
LAN_ENABLED=false
LAN_IP=
TLS_CERT=
TLS_KEY=

AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_VISION_MODEL=gpt-5.6-luna
AI_ANSWER_MODEL=gpt-5.6-luna
ALLOWED_ASSESSMENT_ORIGINS=
