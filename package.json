{
  "name": "authorized-screen-assistant",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx apps/server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx apps/server/index.ts",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write apps packages tests *.ts *.json *.html docs README.md"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "ws": "^8.18.0"
  }
}
